---
// Hero Section — v2 hero restored: Revolt is broader than the workspace
// ------------
import SectionWithImage from '../../ui/SectionWithImage.astro'
import Button from '../../ui/Button.astro'
import heroImage from '../../../assets/home-hero.jpeg'
import Eyebrow from '../../ui/Eyebrow.astro'
import { Icon } from 'astro-icon/components'
---

<SectionWithImage
	id="hero"
	image={heroImage}
	imageAlt="Technical aerial view of a large scale battery energy storage system facility with white containers and power transformers under clear daylight"
	surfaceColor
	mode="light"
	classes="md:h-[calc(100dvh-110px)] md:max-h-[940px]"
	imageClasses="grayscale-[0.2] contrast-[1.1] !object-fill"
>
	<div class="relative z-10 flex flex-col justify-center">
		<Eyebrow title="Grid Intelligence · Germany" />
		<h1 class="mb-8 font-headings text-3xl font-semibold leading-tight lg:text-4xl">
			Find and assess<br />
			<span class="marker-highlight">grid connections</span><br />
			in Germany.
		</h1>
		<p class="mb-10 max-w-xl text-lg leading-relaxed text-neutral-600">
			Compare connection options and understand how grid constraints affect your project. Grid
			intelligence and independent advisory for battery storage, renewables and data centres —
			including projects that combine generation or large loads with batteries.
		</p>
		<div class="flex flex-wrap gap-4">
			<Button size="lg" link="https://cal.com/revoltenergy/introcall" style="accent-light">
				Discuss your project</Button
			>
			<Button variation="link" style="neutral" size="lg" link="/gridscore">
				<span
					class="flex items-center border-b-2 border-neutral-500 px-0.5 pb-1 font-bold uppercase transition-colors duration-200 hover:text-primary-700"
				>
					Explore GridScore
					<Icon name="arrow-right" class="ml-2" />
				</span>
			</Button>
		</div>
	</div>
</SectionWithImage>
