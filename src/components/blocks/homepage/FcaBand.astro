---
// FCA advisory band — dark petrol register (used ONCE on the page), report-excerpt proof
import Button from '../../ui/Button.astro'
import { Icon } from 'astro-icon/components'
---

<section id="fca-band" class="bg-surface-950 py-20 text-white lg:py-24">
	<div class="container mx-auto grid max-w-6xl items-center gap-14 px-6 lg:grid-cols-2">
		<div>
			<p class="mb-4 font-mono text-xs font-bold uppercase tracking-[0.2em] text-primary-200">
				FCA & connection-offer analysis
			</p>
			<h2 class="mb-6 font-headings text-3xl font-semibold leading-tight text-white lg:text-4xl">
				Flexible connection on the table? Know what it costs before you sign.
			</h2>
			<p class="mb-8 max-w-xl text-lg leading-relaxed text-surface-300">
				Flexible connection agreements get projects connected sooner — and quietly reshape the
				business case. We translate the terms into operating and revenue consequences, with sourced
				figures and modelled impacts marked as modelled.
			</p>
			<div class="flex flex-wrap items-center gap-5">
				<Button size="lg" link="/fca-analysis" style="accent-light">Explore FCA Analysis</Button>
				<a
					href="https://cal.com/revoltenergy/introcall"
					class="flex items-center font-bold uppercase text-primary-200 transition-colors hover:text-white"
				>
					Book a call
					<Icon name="arrow-right" class="ml-2" />
				</a>
			</div>
		</div>
		<div class="justify-self-center lg:justify-self-end">
			<div class="w-full max-w-md rounded-lg bg-white p-6 text-neutral-800 shadow-2xl">
				<div class="mb-1 flex items-baseline justify-between">
					<h3 class="font-headings text-sm font-semibold">Weekly revenues — with and without FCA</h3>
					<span class="text-[10.5px] text-neutral-400">Example values</span>
				</div>
				<p class="mb-4 text-xs text-neutral-400">Revenue streams of a BESS, and the total under flexible-connection rules</p>
				<svg viewBox="0 0 420 175" class="w-full" role="img" aria-label="Weekly BESS revenue by market, with the total under a flexible connection agreement shown as a line">
					<g stroke="#eef2f1" stroke-width="1" stroke-dasharray="4 4">
						<line x1="0" y1="45" x2="420" y2="45"/><line x1="0" y1="80" x2="420" y2="80"/><line x1="0" y1="115" x2="420" y2="115"/>
					</g>
