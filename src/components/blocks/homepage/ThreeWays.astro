---
// Three ways to work with Revolt — offer cards from the approved brand-proposal artifact (v1),
// with visible lime CTAs and no checkbox-style bullets.
import Section from '../../ui/Section.astro'
import Eyebrow from '../../ui/Eyebrow.astro'
import Button from '../../ui/Button.astro'

const offers = [
	{
		title: 'GridScore™ workspace',
		who: 'For developers & investors screening sites',
		points: [
			'Ranked substations across Germany',
			'Congestion & curtailment exposure',
			'Pipeline tracking for your candidates'
		],
		cta: 'Book a demo',
		link: '/contact',
		featured: false
	},
	{
		title: 'FCA & connection review',
		who: 'For projects holding a draft agreement',
		points: [
			'Clause-by-clause commercial assessment',
			'Revenue impact of limits, ramps, penalties',
			'Working paper + results call'
		],
		cta: 'Request a review',
		link: '/fca-analysis',
		featured: true
	},
	{
		title: 'Grid studies & reports',
		who: 'For sites needing decision-grade evidence',
		points: [
			'Substation & corridor congestion studies',
			'Revenue-at-risk quantification',
			'Editable, audit-defensible deliverables'
		],
		cta: 'See Advisory',
		link: '/grid-strategy',
		featured: false
	}
]
---

<Section id="three-ways" mode="light" surfaceColor>
	<div class="mx-auto max-w-5xl">
		<Eyebrow title="What you can buy" />
		<h2 class="mb-10 font-headings text-3xl font-semibold leading-tight text-neutral-700 lg:text-4xl">
			Three ways to work with Revolt.
		</h2>
		<div class="grid gap-5 md:grid-cols-3">
			{
				offers.map((o) => (
					<div
						class:list={[
							'flex flex-col rounded-xl border bg-white p-7',
							o.featured ? 'border-[1.5px] border-primary-500' : 'border-neutral-200'
						]}
					>
						<h3 class="mb-1 font-headings text-lg font-semibold text-neutral-800">{o.title}</h3>
						<p class="mb-5 text-[13px] text-neutral-500">{o.who}</p>
						<ul class="mb-7 space-y-2.5 text-[14.5px] leading-relaxed text-neutral-600">
							{o.points.map((p) => (
								<li class="flex gap-2.5">
									<span class="mt-[9px] h-1.5 w-1.5 shrink-0 rounded-full bg-primary-400" />
									{p}
								</li>
							))}
						</ul>
						<div class="mt-auto">
							<Button size="base" link={o.link} style="accent-light">
								{o.cta}
							</Button>
						</div>
					</div>
				))
			}
		</div>
	</div>
</Section>
