---
// Components
// - Layout
import Layout from '../layouts/Layout.astro'
// - Blocks
import Hero from '../components/blocks/homepage/Hero.astro'
import NeedRows from '../components/blocks/homepage/NeedRows.astro'
import FcaBand from '../components/blocks/homepage/FcaBand.astro'
import Applications from '../components/blocks/homepage/Applications.astro'
import WhyGridData from '../components/blocks/homepage/WhyGridData.astro'
import BlogStrip from '../components/blocks/homepage/BlogStrip.astro'
import CTA from '../components/blocks/homepage/CTA.astro'

// Content
// - SEO
const SEO = {
	title: 'Revolt Energy | Find and assess grid connections in Germany',
	description:
		'Grid intelligence and independent advisory for battery storage, renewables and data centres in Germany: GridScore™ connection screening, FCA analysis and grid studies.'
}
---

<Layout title={SEO.title} description={SEO.description}>
	<Hero />
	<NeedRows />
	<FcaBand />
	<Applications />
	<WhyGridData />
	<BlogStrip />
	<CTA
		secondaryButtonText="Discuss a grid assessment"
		secondaryButtonLink="/contact"
	/>
</Layout>
